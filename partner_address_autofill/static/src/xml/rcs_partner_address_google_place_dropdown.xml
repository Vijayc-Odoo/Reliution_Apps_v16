<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="partner_address_autofill.RcsAddressAutoFill" owl="1">
        <div class="rcs_partner_custom_class">
            <input id="enterLocation" type="text" class="o_input" placeholder="Search Location" t-on-input="_onInput"/>

            <div t-if="state.results.length" id="rcs_dropdown_item"
                 class="rcs_js_cls_addresses_dropdown dropdown-menu show"
                 style="display: white; position: absolute; z-index: 999;">
                <a class="dropdown-item rcs_js_cls_address_dropdown_item"
                   t-foreach="state.results" t-as="address" t-key="address.id"
                   t-on-click="_selectItem"
                   t-att-data-place-id="address['id']"
                   t-att-data-place-name="address['placeName']">
                    <i class="fa fa-map-marker fa-f w me-2" role="img"/>
                    <t t-out="address['placeName']"/>
                </a>
            </div>
        </div>
         <t t-out="props.record.data[this.props.name] or props.record[this.props.name]" t-class="text-muted" t-att-id="'rcs_address'" />
    </t>
</templates>
