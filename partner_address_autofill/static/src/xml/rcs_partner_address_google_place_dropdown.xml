<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="partner_address_autofill.RcsAddressAutoFill">
        <div>
            <input id="enterLocation" type="text" placeholder="Type..." t-on-input="_onInput"/>
<!--                   t-att-value="props.record.data.rcs_contact_google_location"/>-->
            <div t-if="state.results.length"
                 class="rcs_js_cls_addresses_dropdown dropdown-menu show "
                 style="display: white; position: absolute; z-index: 999;">
                <a class="dropdown-item rcs_js_cls_address_dropdown_item"
                   t-foreach="state.results" t-as="address" t-key="address.id" t-on-click="_selectItem"
                   t-att-data-place-id="address['id']" t-att-data-place-name="address['placeName']">
                    <t t-debug=""/>
                    <i class="fa fa-map-marker fa-f w" role="img" t-on-click="_selectItem"/>
                    <t t-out="address['placeName']" t-on-click="_selectItem"/>
                </a>
            </div>
        </div>
    </t>
</templates>

