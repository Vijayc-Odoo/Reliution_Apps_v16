<?xml version="1.0" encoding="utf-8" ?>
<odoo>
	<record id="rcs_contact_address_google_form_view_inherit" model="ir.ui.view">
		<field name="name">sh.contact.address.google.form.view.inherit</field>
		<field name="model">res.partner</field>
			<field name="inherit_id" ref="base.view_partner_form"/> 
			<field name="arch" type="xml">
				<field name='street' position="before">
					<field name='rcs_contact_google_location' placeholder='Enter Location new' widget='rcs_address_auto_complete' class='oe_edit_only  o_input'/>
				</field>
<!--				<div class="rcs_address_dropdown_container position-relative"/>-->
				<div class="o_address_format" position="attributes">
					<attribute name="class" add="rcs_custom_address_format" separator=" "/>
				</div>
 		</field>
	</record>
</odoo>