<?xml version="1.0" encoding="utf-8" ?>
<odoo>
	<record id="rcs_contact_address_google_company_form_view_inherit" model="ir.ui.view">
		<field name="name">rcs.contact.address.google.company.form.view.inherit</field>
		<field name="model">res.company</field>
			<field name="inherit_id" ref="base.view_company_form"/> 
			<field name="arch" type="xml">
				<field name='partner_id' position="before">
					<field name="rcs_is_enable_google_api_key"/>
					<field name='rcs_google_api_key' invisible="rcs_is_enable_google_api_key == False" required="rcs_is_enable_google_api_key == True"/>
					<field name="rcs_google_api_search_char" invisible="rcs_is_enable_google_api_key == False"/>
					<field name="rcs_google_country"  invisible="rcs_is_enable_google_api_key == False"/>
				</field>
 		</field>
	</record>
</odoo>
