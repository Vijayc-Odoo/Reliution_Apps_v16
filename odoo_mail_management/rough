@api.model
def get_document_templates(self, model_name):
    """Get available templates for a specific model"""
    return self.env['mail.template'].search([
        ('model_id.model', '=', model_name)
    ]).read(['id', 'name'])

@api.model
def load_template(self, template_id):
    """Load template content"""
    template = self.env['mail.template'].browse(template_id)
    if template.exists():
        return {
            'subject': template.subject,
            'body_html': template.body_html,
        }
    return {}


attachments = self.env['ir.attachment'].search([
            ('res_model', '=', 'mail.message'),
            ('res_id', '=', mail_id)
        ])

        # Prepare the list of attachments as (0, 0, values) tuples to copy them
        attachment_values = []
        for attachment in attachments:
            attachment_values.append((0, 0, {
                'name': attachment.name,
                'datas': attachment.datas,
                'datas_fname': attachment.datas_fname,
                'mimetype': attachment.mimetype,
