/* @odoo-module */
import { Component } from '@odoo/owl';
import { useService } from "@web/core/utils/hooks";
import { useState, onMounted, markup, useRef } from "@odoo/owl";
import { ComposeReplyDialog } from './ComposeReplyDialog.js';
import { ComposeForwardDialog } from './ComposeForwardDialog.js';
import { useMailUtils } from './MailUtils.js';

/**
 * MessageView component for displaying a message and its thread.
 * @extends Component
 */
export class MessageView extends Component {
    setup() {
        this.root = useRef("root-mail");
        this.action = useService("action");
        this.orm = useService("orm");
        this.mailUtils = useMailUtils();
        this.state = useState({
            thread: [], // For entire thread
            attachments: {}
        });

        onMounted(this.fetchThread);
    }

    async fetchThread() {
        const thread = await this.orm.call('mail.mail', 'get_mail_thread', [this.props.mail.id]);
        this.state.thread = thread;
        // Fetch attachments for each mail (optional)
        for (const mail of thread) {
            if (mail.attachment_ids && mail.attachment_ids.length) {
                const result = await this.orm.call("ir.attachment", "get_fields", [mail.attachment_ids]);
                this.state.attachments[mail.id] = result;
            }
        }
    }

    async replyMail(mail) {
        this.env.services.dialog.add(ComposeReplyDialog, { mail });
    }

    async forwardMail(mail) {
        this.env.services.dialog.add(ComposeForwardDialog, { mail });
    }

    async markAsDone(mail) {
        await this.mailUtils.markAsDone(mail.id);
        window.location.reload();
    }

    async snoozeMail(mail) {
        await this.mailUtils.snoozeMail(mail.id);
        window.location.reload();
    }

    async markAsUnread(mail) {
        await this.mailUtils.markAsUnread(mail.id);
        window.location.reload();
    }

    async onClickAttachment(attachmentId) {
        this.action.doAction({
            type: "ir.actions.act_url",
            url: `/web/content/${attachmentId}?download=true`
        });
    }
}
