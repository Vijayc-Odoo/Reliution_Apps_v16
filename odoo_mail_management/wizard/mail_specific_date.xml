<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="fetch_mails_between_dates" model="ir.ui.view">
        <field name="name">fetch.mails.between.dates.form</field>
        <field name="model">fetch.mails.between.dates</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="from_date"/>
                        <field name="to_date"/>
                        <field name="fetchmail_server_id"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Fetch Mail" type="object" name="fetch_mails_between_dates" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>

            </form>
        </field>

    </record>
</odoo>