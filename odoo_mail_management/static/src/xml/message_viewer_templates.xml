<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="MessageView" owl="1">
        <div class="message" t-ref="root-mail">
            <t t-foreach="state.thread" t-as="mail" t-key="mail.id">
                <div class="mail-thread-item" style="border:1px solid #e0e0e0; padding:16px; margin-bottom:16px; border-radius:8px; background:#fff; box-shadow:0 1px 2px rgba(0,0,0,0.1); color:#000000">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 t-out="props.mail.subject" style="margin:0; font-size:16px; font-weight:500; color:#000000"/>
                        <div class="text-muted" style="font-size:13px;">
                            <t t-out="formatDate(mail.date)"/>
                        </div>
                    </div>

                    <div class="d-flex align-items-center mb-2" style="font-size:14px;">
                        <strong style="min-width:40px;">From:</strong>
                        <span t-out="mail.email_from" style="color:#202124;"/>
                    </div>

                    <div class="d-flex align-items-center mb-3" style="font-size:14px;">
                        <strong style="min-width:40px;">To:</strong>
                        <span t-out="mail.email_to" style="color:#202124;"/>
                    </div>
                    <t t-if="mail.email_cc">
                        <div class="d-flex align-items-center mb-3" style="font-size:14px;">
                            <strong style="min-width:40px;">Cc:</strong>
                            <span t-out="mail.email_cc" style="color:#202124;"/>
                        </div>
                    </t>

                    <div class="mail-body mb-3" t-out="markup(mail.body_html)" style="font-size:14px; line-height:1.5; color:#202124;"/>
                    <t t-if="state.attachments[mail.id]">
                        <div class="attachments mb-3">
                            <t t-foreach="state.attachments[mail.id]" t-as="attachment" t-key="attachment.attachment">
                                <div class="attachment-item d-flex align-items-center mb-1" style="font-size:13px;">
                                    <i class="fa fa-paperclip me-2" style="color:#5f6368;"/>
                                    <span t-out="attachment.name" style="color:#1a73e8;"/>
                                    <button class="btn btn-link p-0 ms-2" t-on-click="() => this.onClickAttachment(attachment.attachment)" style="color:#1a73e8; font-size:13px; text-decoration:none;">
                                        Download
                                    </button>
                                </div>
                            </t>
                        </div>
                    </t>

                    <div class="d-flex align-items-center justify-content-between border-top pt-3">
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-secondary btn-sm"  t-on-click="() => replyMail(mail, env)" style="border-radius:20px; padding:6px 12px; font-size:13px;">
                                Reply
                            </button>
                            <button class="btn btn-outline-secondary btn-sm" t-on-click="() => forwardMail(mail, env)" style="border-radius:20px; padding:6px 12px; font-size:13px;">
                                Forward
                            </button>
                        </div>

                        <div class="d-flex align-items-center">
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
