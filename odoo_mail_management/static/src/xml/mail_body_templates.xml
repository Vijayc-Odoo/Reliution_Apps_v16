            <button class="btn read_btn" t-if="!props.mail.is_read"
                    t-on-click="() => this.markAsRead(props.mail)">📩</button>
            <button class="btn unread_btn" t-if="props.mail.is_read"
                    t-on-click="() => this.markAsUnread(props.mail)">✉</button>
