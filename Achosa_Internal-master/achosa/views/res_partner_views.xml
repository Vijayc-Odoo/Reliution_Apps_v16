<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="vendor_type" model="ir.ui.view">
        <field name="name">res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field eval="20" name="priority"/>
        <field name="arch" type="xml">
            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[1]/field[@name='child_ids']/form[1]/sheet[1]/group[2]/field[@name='comment']"
                   position="after">
                <field name="vendor_type"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_kanban_details')]" position="inside">
                <div t-if="record.vendor_type">Vendor:
                    <field name="vendor_type"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>