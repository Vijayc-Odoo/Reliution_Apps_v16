<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data>
        <!--    server actions for Activities to be done -->
        <record id="action_mark_late_activities_done" model="ir.actions.server">
            <field name="name">Mark Late Activities as Done</field>
            <field name="model_id" ref="model_crm_lead"/>
            <field name="binding_model_id" ref="crm.model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">
                for rec in records:
                rec.activity_ids.filtered(lambda a: a.state == 'overdue').action_feedback(feedback='Closed automatically in batch')
            </field>
        </record>

        <record id="action_mark_activities_done" model="ir.actions.server">
            <field name="name">Mark All Activities as Done</field>
            <field name="model_id" ref="model_crm_lead"/>
            <field name="binding_model_id" ref="crm.model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">
                for rec in records:
                rec.activity_ids.action_feedback(feedback='Closed automatically in batch')
            </field>
        </record>

        <record id="crm_iap_enrich.crm_lead_view_form" model="ir.ui.view">
            <field name="active">False</field>
        </record>

        <!-- inherit view of Lead Form : replacing the company field -->
        <record id="crm_lead_view_form_achosa_inherit" model="ir.ui.view">
            <field name="name">crm.lead.form.achosa.inherit</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="/form//sheet//group//group[@name='opportunity_partner']//field['partner_id']"
                   position="replace">
                <field name="partner_id"
                       widget="res_partner_many2one"
                       string="Customer"
                       context="{'res_partner_search_mode': type == 'opportunity' and 'customer' or False,
                                        'default_name': contact_name or partner_name,
                                        'default_street': street,
                                        'default_street2': street2,
                                        'default_city': city,
                                        'default_title': title,
                                        'default_state_id': state_id,
                                        'default_zip': zip,
                                        'default_country_id': country_id,
                                        'default_function': function,
                                        'default_phone': phone,
                                        'default_mobile': mobile,
                                        'default_email': email_from,
                                        'default_user_id': user_id,
                                        'default_team_id': team_id,
                                        'default_website': website,
                                        'show_vat': True,
                                    }"
                       domain="[('vendor_type', 'in', ['Realtor', 'Closing','Coordinator']), ('is_company', '=', False)]"
                />
            </xpath>
                <xpath expr="//group[2]/field[@name='partner_id']" position="after">
                    <field name="parent_id" domain="[('is_company', '=', True)]" context="{'default_is_company': 1}"/>
                </xpath>

                <xpath expr="//field[@name='user_id']" position="replace">
                    <field name="user_id"
                           context="{'default_groups_ref': ['base.group_user', 'base.group_partner_manager', 'sales_team.group_sale_salesman_all_leads'], 'team_id': team_id}"/>
                </xpath>
                <xpath expr="//field[@name='phone']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='company_id']" position="after">
                    <field string="Phone" name="contact_link_phone" widget="phone" options="{'enable_sms': True}"/>
                    <field string="Mobile" name="contact_link_mobile" widget="phone" options="{'enable_sms': True}"/>
                    <field string="Email" name="contact_link_email" widget="email"/>
                    <field string="Vendor Type" name="contact_link_vendor_type"/>
                    <field string="Opt-in Emails" name="opt_email"/>
                </xpath>
                <!--           <xpath expr="//field[@name='partner_address_email']" position="attributes"> -->
                <!--                 <attribute name="invisible">1</attribute> -->
                <!--           </xpath>  -->
                <xpath expr="//form[1]/sheet[1]/group[1]/group[@name='opportunity_partner']/label[1]"
                       position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='email_from']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//label[@for='phone']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//button[@name='toggle_active']" position="before">
                    <button class="oe_stat_button" name="action_view_home_warranties" type="object"
                            icon="fa-shopping-cart"
                            attrs="{'invisible': [('partner_id','=',False)]}">
                        <field string="Home Warranties" name="total_orders" widget="statinfo"/>
                    </button>
                </xpath>

                <xpath expr="//field[@name='partner_name']" position="after">
                    <field name="partner_company" string="Company" domain="[['is_company','=',True]]"
                           context="{'default_street': street, 'default_city': city, 'default_state_id': state_id,
                   'default_zip': zip, 'default_country_id': country_id, 'default_is_company': True,
                   'default_phone': phone, 'default_mobile': mobile, 'default_email': email_from,
                   'default_user_id': user_id, 'default_team_id': team_id, 'default_website': website,
                   'default_company_type': 'company'}"/>
                </xpath>
            </field>
        </record>
        <record id="view_crm_lead2opportunity_partner_inherit" model="ir.ui.view">
            <field name="name">crm.lead2opportunity.partner.form.inherit</field>
            <field name="model">crm.lead2opportunity.partner</field>
            <field name="inherit_id" ref="crm.view_crm_lead2opportunity_partner"/>
            <field name="arch" type="xml">
                <xpath expr="//group[3]//field[@name='duplicated_lead_ids']/tree" position="inside">
                    <field name="phone"/>
                </xpath>
            </field>
        </record>
        <record id="quick_create_opportunity_form_inherit" model="ir.ui.view">
<!--        crm.quick_create_opportunity_form-->
        <field name="name">crm.lead.form.kanban.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.quick_create_opportunity_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[1]" position="replace">
                <group>
                    <field name="name" string="Name" invisible="1" placeholder="e.g. Product Pricing"/>
                    <field name="partner_id" widget="res_partner_many2one"
                           string='Customer'
                           context="{
                            'res_partner_search_mode': type == 'opportunity' and 'customer' or False,
                            'default_name': contact_name or partner_name,
                            'default_phone': phone,
                            'default_email': email_from,
                            'default_user_id': user_id,
                            'default_team_id': team_id,
                            'show_vat': True}" domain="[('vendor_type', 'in', ['Realtor', 'Closing','Coordinator']),('is_company', '=', False)]"/>
                    <field name="parent_id" string="Company" domain="[('vendor_type', 'in', ['Realtor', 'Closing','Coordinator']), ('is_company', '=', True)]"
                           context="{'default_is_company': 1}"/>
                    <field name="email_from" string="Email"/>
                    <field name="phone" string="Phone"/>
                    <field name="contact_link_phone" invisible="1"/>
                    <field name="contact_link_email" invisible="1"/>
                    <field name="contact_link_vendor_type" invisible="1"/>
                    <label for="expected_revenue"/>
                    <div class="o_row">
                            <field name="expected_revenue" class="oe_inline mr-5" widget="monetary" options="{'currency_field': 'company_currency'}"/>
                            <field name="priority" class="oe_inline" nolabel="1" widget="priority"/>
                        </div>
                        <div class="o_row">
                            <field name="recurring_revenue" class="oe_inline pr-4" widget="monetary" options="{'currency_field': 'company_currency'}"/>
                            <field name="recurring_plan" class="oe_inline" placeholder="E.g. Monthly"
                                   attrs="{'required': [('recurring_revenue', '!=', 0)]}" options="{'no_create': True, 'no_open': True}"/>
                        </div>
                        <field name="company_currency" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                        <field name="user_id" invisible="1"/>
                        <field name="user_company_ids" invisible="1"/>
                        <field name="team_id" invisible="1"/>
                        <field name="type" invisible="1"/>
                        <field name="partner_name" invisible="1"/>
                        <field name="contact_name" invisible="1"/>
                        <field name="country_id" invisible="1"/>
                        <field name="state_id" invisible="1"/>
                        <field name="city" invisible="1"/>
                        <field name="street" invisible="1"/>
                        <field name="street2" invisible="1"/>
                        <field name="zip" invisible="1"/>
                        <field name="mobile" invisible="1"/>
                        <field name="website" invisible="1"/>
                        <field name="function" invisible="1"/>
                        <field name="title" invisible="1"/>
                    </group>
            </xpath>
        </field>
    </record>
    </data>


