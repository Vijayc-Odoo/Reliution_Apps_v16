<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record model="ir.actions.report" id="claims_report_terms">
        <field eval="False" name="attachment"/>
        <field eval="False" name="attachment_use"/>
        <field name="binding_model_id" ref="achosa.model_claims"/>
        <field name="binding_type">report</field>
        <field eval="[(6, 0, [])]" name="groups_id"/>
        <field name="model">claims</field>
        <field eval="False" name="multi"/>
        <field name="name">Claim Terms</field>
        <field name="report_name">achosa.claims_report_terms_view</field>
        <field name="report_type">qweb-pdf</field>
    </record>
    <record model="ir.ui.view" id="claims_report_terms_view">
        <field eval="True" name="active"/>
        <field name="arch" type="xml">
            <t t-name="report_blank">
                <t t-call="web.html_container">
                    <t t-foreach="docs" t-as="doc">
                        <t t-call="web.external_layout">
                            <div class="page">
                                <h1 t-field="doc.product.product_id.description_sale"/>
                                <div style="padding:15px">
                                    <h2>Terms:</h2>
                                    <span t-field="doc.product.product_id.warranty_terms_long"/>
                                </div>
                            </div>
                        </t>
                    </t>
                </t>
            </t>
        </field>
        <field eval="False" name="field_parent"/>
        <field eval="[(6, 0, [])]" name="groups_id"/>
        <field eval="False" name="inherit_id"/>
        <field name="mode">primary</field>
        <field eval="False" name="model"/>
        <field name="name">claims_report_terms_view</field>
        <field name="priority">16</field>
        <field name="type">qweb</field>
    </record>
</odoo>