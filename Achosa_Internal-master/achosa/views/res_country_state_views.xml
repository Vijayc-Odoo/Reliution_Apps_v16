<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="achosa_view_country_state_form_inherit" model="ir.ui.view">
        <field name="name">achosa.res.country.state.form.inhert</field>
        <field name="model">res.country.state</field>
        <field name="inherit_id" ref="base.view_country_state_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='country_id']" position="after">
                <field name="enable_home_warranty"/>
            </xpath>
        </field>
    </record>
    <!-- State -->
    <record id="view_country_state_tree" model="ir.ui.view">
        <field name="name">res.country.state.tree</field>
        <field name="model">res.country.state</field>
        <field name="arch" type="xml">
            <tree string="State">
                <field name="name"/>
                <field name="code"/>
                <field name="country_id"/>
                <field name="enable_home_warranty"/>
            </tree>
        </field>
    </record>
    <record id="action_country_state" model="ir.actions.act_window">
        <field name="name">States</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.country.state</field>

        <field name="view_id" ref="achosa.view_country_state_tree"/>
        <field name="help">You can manage the different states you are working on from here. Each state is attached to one country.</field>
        <field name="context">{}</field>
        <field name="domain" eval="[['country_id.code','=','US']]"/>
    </record>
</odoo>