<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_subscription.mail_template_subscription_invoice" model="mail.template">
        <field name="name">Invoice: Payment Confirmation</field>
        <field name="model_id" ref="achosa.model_account_move"/>
        <field name="email_from">{{(object.invoice_user_id.email_formatted or user.email_formatted)}}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="subject">{{object.company_id.name}} Invoice (Ref {{object.name or 'n/a'}})</field>
        <field name="report_name">Invoice_{{ (object.name or '').replace('/','_') }}{{ object.state == 'draft' and '_draft' or '' }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="body_html" type="html">
            <t t-if="object.home_warranty and object.home_warranty.state == 'Buyer'" data-oe-t-group="0" data-oe-t-selectable="true" data-oe-t-group-active="true" data-oe-t-inline="true">
   Congratulations on your new home! We are sending you this e-mail to confirm that we have received payment for your home warranty. As we know moving is a hectic time and sometimes our paperwork gets lost in the closing documents, we are sending you a few items.
</t>
<t t-else="" data-oe-t-selectable="true" data-oe-t-group="0" data-oe-t-inline="true">
   We are sending you this e-mail to confirm that we have received payment for your home warranty. Further, we are sending you a few items for your information.
</t>
<p style="box-sizing:border-box;margin:0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;">We have included an invoice that shows your home warranty has been paid, this item is attached at the bottom of this email. There are also 2 links directly below. The first link we have included is a document that explains our service process, and the second link is for the terms &amp; conditions of your home warranty.</p>
<p style="box-sizing:border-box;margin-right: 20em;">
   <a target="_blank" class="badge badge-pill badge-info" style="box-sizing:border-box;text-decoration:none;border-radius:120px;border-style:solid;padding:0.25em 0.6em 0.25em 0.6em;margin:1px 2px 1px 0px;border-left-color:#00a09d;border-bottom-color:#00a09d;border-right-color:#00a09d;border-top-color:#00a09d;border-left-width:1px;border-bottom-width:1px;border-right-width:1px;border-top-width:1px;transition-property:color, background-color, border-color, box-shadow;transition-delay:0s, 0s, 0s, 0s;transition-timing-function:ease-in-out, ease-in-out, ease-in-out, ease-in-out;transition-duration:0.15s, 0.15s, 0.15s, 0.15s;vertical-align:baseline;white-space:nowrap;text-align:center;line-height:1;font-weight:700;font-size:100%;display:inline-block;background-color:#87c0d1;color:#212529;" t-attf-href="{{ object.env['ir.config_parameter'].sudo().get_param('web.base.url') }}/web/content/{{ object.env.company.service_map_attachment_id }}">
      <t t-out="object.env.company.service_map_attachment_name" contenteditable="false" data-oe-t-inline="true" oe-keep-contenteditable=""></t>
      .pdf
   </a>
</p>
<p style="box-sizing:border-box;margin-bottom: 0px;">
   <a target="_blank" class="badge badge-pill badge-info" style="box-sizing:border-box;text-decoration:none;border-radius:120px;border-style:solid;padding:0.25em 0.6em 0.25em 0.6em;margin:1px 2px 1px 0px;border-left-color:#00a09d;border-bottom-color:#00a09d;border-right-color:#00a09d;border-top-color:#00a09d;border-left-width:1px;border-bottom-width:1px;border-right-width:1px;border-top-width:1px;transition-property:color, background-color, border-color, box-shadow;transition-delay:0s, 0s, 0s, 0s;transition-timing-function:ease-in-out, ease-in-out, ease-in-out, ease-in-out;transition-duration:0.15s, 0.15s, 0.15s, 0.15s;vertical-align:baseline;white-space:nowrap;text-align:center;line-height:1;font-weight:700;font-size:100%;display:inline-block;background-color:#87c0d1;color:#212529;" t-attf-href="{{ object.env['ir.config_parameter'].sudo().get_param('web.base.url') }}/web/content/{{ object.env.company.homeowner_attachment_id }}">
      <t t-out="object.env.company.homeowner_attachment_name" contenteditable="false" data-oe-t-inline="true" oe-keep-contenteditable=""></t>
      .pdf
   </a>
</p>
            <p style="box-sizing:border-box;margin-bottom: 0px;"><br></br>
</p>
<p style="box-sizing:border-box;margin:0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;">If you have any questions, you can reach us at (888) 509-2916 or at info@achosahw.com. Thank you and have a wonderful day!</p>
<t t-if="object.first_invoice and not object.check_renewal_product() and not object.home_warranty.state == 'Buyer'" data-oe-t-group="1" data-oe-t-selectable="true" data-oe-t-group-active="true">
   <p style="box-sizing:border-box;margin:0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;"><b style="box-sizing:border-box;font-weight:bolder;">Note for New Customers</b></p>
   <p style="box-sizing:border-box;margin:0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;">Please remember that your coverage will not begin until 30 days after today. Your next monthly payment will automatically process at that time. All recurring payments will automatically process monthly thereafter.</p>
</t>
<t t-elif="object.first_invoice and object.check_renewal_product()" data-oe-t-selectable="true" data-oe-t-group="1">
   <p style="box-sizing:border-box;margin:0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;"><b style="box-sizing:border-box;font-weight:bolder;">Note for Customers Just Renewing</b></p>
   <p style="box-sizing:border-box;margin:0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;">Your renewal plan will begin immediately after your current plan expires. Your second monthly payment will automatically process one month after your renewal plan begins. All recurring payments will automatically process monthly thereafter.</p>
</t>
<p style="box-sizing:border-box;margin:0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;color:#888888;">
   <t t-if="object.user_id and object.user_id.signature" data-oe-t-group="2" data-oe-t-group-active="true" data-oe-t-inline="true">
      <t t-out="object.user_id.signature" contenteditable="false" data-oe-t-inline="true" oe-keep-contenteditable=""></t>
   </t>
</p>
<p style="box-sizing:border-box;margin-bottom: 0px;">
   <!-- The two buttons need to be updated whenever the terms or process map are updated.  The companies parameters page should be updated to have the link for both (JIRA AO-845)-->
</p>
<p style="margin:0px 0 12px 0;box-sizing:border-box;"></p>
        </field>
    </record>
    
    <record id="achosa_mail_template_subscription_invoice_backup" model="mail.template">
        <field name="name">Subscription Invoice: Send by Email (backup)</field>
        <field name="model_id" ref="achosa.model_account_move"/>
        <field name="email_from">{{(object.invoice_user_id.email_formatted or user.email_formatted)}}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="subject">{{object.company_id.name}} Invoice (Ref {{object.name or 'n/a'}})</field>
        <field name="body_html" type="html">
            <p style="box-sizing:border-box;margin-bottom: 0px;">
   <!-- This template previously had ID = 138, but was referenced by XML_ID = "sale_subscription.mail_template_subscription_invoice" in enterprise code.  This backup is to preserve the functionality in case we want it again some day. -->
</p>
<div style="background:#F0F0F0;color:#515166;padding:10px 0px;font-family:Arial,Helvetica,sans-serif;font-size:14px;">
   <table style="box-sizing:border-box;border-collapse:collapse;width:600px;margin:5px auto;" width="600px">
      <tbody>
         <tr>
            <td>
               <a href="/" style="text-decoration:none;box-sizing:border-box;background-color:transparent;color:#008f8c;"><img src="/web/binary/company_logo" style="border-style:none;box-sizing:border-box;vertical-align: baseline; max-width: 100px; width: 100px; height: 100px;" width="100px" height="100"/></a>
            </td>
            <td style="text-align:right;vertical-align:middle;">
               Subscription Invoice
            </td>
         </tr>
      </tbody>
   </table>
   <table style="border-style:solid;box-sizing:border-box;border-left-color:#e1e1e1;border-bottom-color:#e1e1e1;border-right-color:#e1e1e1;border-top-color:#e1e1e1;border-left-width:1px;border-bottom-width:1px;border-right-width:1px;border-top-width:1px;background-color:white;background-clip:initial;background-origin:initial;background-attachment:initial;background-repeat-y:initial;background-repeat-x:initial;background-size:initial;background-position-y:initial;background-position-x:initial;background-image:initial;border-collapse:collapse;width:600px;margin:0px auto;background:white;border:1px solid #e1e1e1;" width="600px">
      <tbody>
         <tr>
            <td style="padding:15px 20px 10px 20px;">
               <p style="margin:0px 0 12px 0;box-sizing:border-box;">
                  Dear 
                  <t t-out="object.partner_id.name or ''" contenteditable="false" data-oe-t-inline="true">Brandon Freeman</t>
                  <t t-if="object.partner_id.parent_id" data-oe-t-group="0" data-oe-t-group-active="true" data-oe-t-inline="true">
                     (
                     <t t-out="object.partner_id.parent_id.name or ''" contenteditable="false" data-oe-t-inline="true">Azure Interior</t>
                     )
                  </t>
               </p>
               <p style="margin:0px 0 12px 0;box-sizing:border-box;">
                  Here is, in attachment, your
                  <t t-if="object.name" data-oe-t-group="1" data-oe-t-selectable="true" data-oe-t-group-active="true" data-oe-t-inline="true">
                     invoice <strong t-out="object.name or ''" style="box-sizing:border-box;font-weight:500;" contenteditable="false">Office Cleaning Service"</strong>
                  </t>
                  <t t-else="" data-oe-t-selectable="true" data-oe-t-group="1" data-oe-t-inline="true">
                     invoice
                  </t>
                  <t t-if="object.invoice_origin" data-oe-t-group="2" data-oe-t-group-active="true" data-oe-t-inline="true">
                     (with reference: 
                     <t t-out="object.invoice_origin or ''" contenteditable="false" data-oe-t-inline="true">INVOICE_ORIGIN</t>
                     )
                  </t>
                  amounting in <strong t-out="format_amount(object.amount_total, object.currency_id) or ''" style="box-sizing:border-box;font-weight:500;" contenteditable="false">$ 10.00</strong>
                  from 
                  <t t-out="object.company_id.name or ''" contenteditable="false" data-oe-t-inline="true">YourCompany</t>
                  .
                  <t t-if="object.payment_state in ('paid', 'in_payment')" data-oe-t-group="3" data-oe-t-selectable="true" data-oe-t-group-active="true" data-oe-t-inline="true">
                     This invoice is already paid.
                  </t>
                  <t t-else="" data-oe-t-selectable="true" data-oe-t-group="3" data-oe-t-inline="true">
                     Please remit payment at your earliest convenience.
                  </t>
               </p>
               <p style="margin:0px 0 12px 0;box-sizing:border-box;">Do not hesitate to contact us if you have any questions.</p>
            </td>
         </tr>
         <tr>
            <td style="padding:15px 20px 10px 20px;" t-out="object.invoice_user_id.signature or ''" contenteditable="false">--<br>Mitchell Admin</br></td>
         </tr>
      </tbody>
   </table>
</div>
        </field>
        </record>
    
    <record id="achosa_mail_template_user_signup_account_created" model="mail.template">
