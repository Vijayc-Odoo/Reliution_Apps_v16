<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data noupdate="1">
        <record id="claim_number_seq" model="ir.sequence">
            <field name="name">Claim Number Sequence</field>
            <field name="code">claim.number.seq</field>
            <field name="prefix">CL/%(year)s/</field>
            <field name="padding">10</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="hw_number_seq" model="ir.sequence">
            <field name="name">Home Warranty Sequence</field>
            <field name="code">home.warranty.seq</field>
            <field name="number_next">100</field>
            <field name="prefix">HW/%(year)s/</field>
            <field name="padding">10</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>