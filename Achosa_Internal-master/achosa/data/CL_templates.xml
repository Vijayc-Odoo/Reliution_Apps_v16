<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data noupdate="1">
        <record id="claims_email_diag" model="mail.template">
            <field name="name">Claim Email Diag</field>
            <field name="subject">RE: Claim {{object.display_name}}</field>
            <field name="email_from">claims@achosahw.com</field>
            <field name="model_id" ref="achosa.model_claims"/>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <p style="margin:0px 0px 9px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;">
                    <span>
                        We are happy to know that your technician has diagnosed the issue with your <t
                            t-out="object.item_name" contenteditable="false" data-oe-t-inline="true"></t>. Per our
                        discussion, this e-mail captures our understanding of next steps.
                    </span>
                </p>
                <p style="margin:0px 0px 9px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;">
                    <span>
                        You have authorized the technician to repair (or replace) your <t t-out="object.item_name"
                                                                                          contenteditable="false"
                                                                                          data-oe-t-inline="true"></t>.
                        The technician has
                        quoted a total invoice of $<t t-out="&quot;%.2f&quot; % object.requested_amt"
                                                      contenteditable="false" data-oe-t-inline="true"></t> to get your <t
                            t-out="object.item_name" contenteditable="false" data-oe-t-inline="true"></t> up and running
                        again.
                    </span>
                </p>
                <p style="margin:0px 0px 9px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;">
                    <span>
                        Per our agreement, we will pay $<t t-out="&quot;%.2f&quot; % object.approved_amt"
                                                           contenteditable="false" data-oe-t-inline="true"></t> from
                        that invoice. The remaining $<t
                            t-out="&quot;%.2f&quot; % (object.requested_amt-object.approved_amt)"
                            contenteditable="false" data-oe-t-inline="true"></t> will be paid
                        by you.
                    </span>
                </p>
                <p style="margin:0px 0px 9px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;">
                    <span>Please call us back at (888) 509 2916 and press #3 for claims when the technician has
                        completed the work to your satisfaction. We will then arrange our payment to the technician.
                        Please note that we will require the technician to email us the invoice, or a picture thereof,
                        upon payment.
                    </span>
                </p>
                <p style="margin:0px 0px 9px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;">
                    <span>
                        Thank you again for choosing Achosa. We appreciate your business!
                    </span>
                </p>
                <p style="margin:0px 0px 9px 0px;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;">
                    <span>
                        Achosa Home Warranty Claims Team
                    </span>
                </p>
