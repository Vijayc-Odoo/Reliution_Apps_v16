<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--Email template -->
        <record model="mail.template" id="missed_transaction_data">
            <field name="name">Missed Transactions</field>
            <field name="subject">Missed Transactions</field>
            <field name="email_from">abc@example.com</field>
            <field name="email_to">abc@example.com</field>
            <field name="reply_to">abc@example.com</field>
            <field name="partner_to"></field>
            <field name="model_id" ref="payment_transaction_data.model_transaction_audit"/>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">

                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear User, <br/>
                        Below is the missed Transaction Id and Date of the Transaction. Please review it and take the
                        required action.
                        <br/>
                        <br/>
                        <strong>Report Date:  <t t-esc="object.report_date"/> </strong>
                        <br/>
                        <br/>

                        <span><b style="font-size: 20px;"><center>Settled Transaction</center></b></span>
                        <br/>
                        <table style="width:100%;">
                            <thead>
                                <tr>
                                    <th style="width: 20%;">Customer Name</th>
                                    <th style="width: 10%;">Invoice Number</th>
                                    <th style="width: 12%;">Transaction Id</th>
                                    <th style="width: 13%;">Transaction Date</th>
                                    <th style="width: 7%;">Amount</th>
                                    <th style="width: 13%;">Status</th>
                                    <th style="width: 15%;">Card Status</th>
                                    <th style="width: 10%;">CAVV Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="transaction_data" t-value="ctx['transaction_data']"/>
                                <div t-foreach="transaction_data" t-as="transaction">
                                    <div t-foreach="transaction.transaction_audit_line_ids" t-as="line">
                                        <tr>
                                            <td style="width: 20%;"> <t t-esc="line.customer_name or ''"/> </td>
                                            <td style="width: 10%;"> <t t-esc="line.invoice_no or ''"/> </td>
                                            <td style="width: 12%;"> <t t-esc="line.transaction_no or ''"/> </td>
                                            <td style="width: 13%;"> <t t-esc="line.transaction_date or ''"/> </td>
                                            <td style="width: 7%;"> <t t-esc="line.amount or 0.0"/> </td>
                                            <td style="width: 13%;"> <t t-esc="line.status or ''"/> </td>
                                            <td style="width: 15%;"> <t t-esc="line.card_response or ''"/> </td>
                                            <td style="width: 10%;"> <t t-esc="line.cavv_response or ''"/> </td>
                                        </tr>
                                    </div>
                                </div>
                            </tbody>
                        </table>
                        <br/>
                        <hr style="border: 1px solid black;"/>

                        <span style="font-size: 20px;"><b><center>Unsettled Transaction</center></b></span>
                        <br/>
                        <table style="width:100%;">
                            <thead>
                                <tr>
                                    <th style="width: 20%;">Customer Name</th>
                                    <th style="width: 10%;">Invoice Number</th>
                                    <th style="width: 12%;">Transaction Id</th>
                                    <th style="width: 13%;">Transaction Date</th>
                                    <th style="width: 7%;">Amount</th>
                                    <th style="width: 13%;">Status</th>
                                    <th style="width: 15%;">Card Status</th>
                                    <th style="width: 10%;">CAVV Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="transaction_data" t-value="ctx['transaction_data']"/>
                                <div t-foreach="transaction_data" t-as="transaction">
                                    <div t-foreach="transaction.unsettled_transaction_ids" t-as="line">
                                        <tr>
                                            <td style="width: 20%;"> <t t-esc="line.customer_name or ''"/> </td>
                                            <td style="width: 10%;"> <t t-esc="line.invoice_no or ''"/> </td>
                                            <td style="width: 12%;"> <t t-esc="line.unsettled_transaction_no or ''"/> </td>
                                            <td style="width: 13%;"> <t t-esc="line.unsettled_transaction_date or ''"/> </td>
                                            <td style="width: 7%;"> <t t-esc="line.amount or 0.0"/> </td>
                                            <td style="width: 13%;"> <t t-esc="line.status or ''"/> </td>
                                            <td style="width: 15%;"> <t t-esc="line.card_response or ''"/> </td>
                                            <td style="width: 10%;"> <t t-esc="line.cavv_response or ''"/> </td>
                                        </tr>
                                    </div>
                                </div>
                            </tbody>
                        </table>
                        <br/>
                        <hr style="border: 1px solid black;"/>
                        <br/>
                        <div>
                            <b style="font-size: 18px;"><center>CAVV Response Code</center></b><br/>
                            <span style="font-size: 14px;">
                                0 = CAVV was not validated because erroneous data was submitted.<br/>
                                1 = CAVV failed validation.<br/>
                                2 = CAVV passed validation.<br/>
                                3 = CAVV validation could not be performed; issuer attempt incomplete.<br/>
                                4 = CAVV validation could not be performed; issuer system error.<br/>
                                5 = Reserved for future use.<br/>
                                6 = Reserved for future use.<br/>
                                7 = CAVV failed validation, but the issuer is available. Valid for U.S.-issued card submitted to non-U.S acquirer.<br/>
                                8 = CAVV passed validation and the issuer is available. Valid for U.S.-issued card submitted to non-U.S. acquirer.<br/>
                                9 = CAVV failed validation and the issuer is unavailable. Valid for U.S.-issued card submitted to non-U.S acquirer.<br/>
                                A = CAVV passed validation but the issuer unavailable. Valid for U.S.-issued card submitted to non-U.S acquirer.<br/>
                                B = CAVV passed validation, information only, no liability shift.<br/>
                            </span>
                        </div>
                        <br/>
                        Thank You,<br/>
                        <t t-esc="object.company_id.name"/>
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>
