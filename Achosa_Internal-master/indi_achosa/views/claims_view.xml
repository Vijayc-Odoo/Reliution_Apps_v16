<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_claims_filter" model="ir.ui.view">
            <field name="name">claims.search</field>
            <field name="model">claims</field>
            <field name="arch" type="xml">
                <search string="Search Claims">
                    <separator/>
                    	<field name="name"/>
                    	<field name="user_id"/>
                    	<field name="property_street" string="Street"/>
                        <filter string="Street" name="property_street" context="{'group_by': 'property_street'}"/>
                </search>
            </field>
        </record>

    <record id="default_tree_view_for_claims_inh" model="ir.ui.view">
            <field name="name">claims.tree</field>
            <field name="model">claims</field>
            <field name="inherit_id" ref="achosa.default_tree_view_for_claims"/>
            <field name="arch" type="xml">
                <field name="customer" position="after">
                	<field name="item_name"/>
                </field>
            </field>
        </record>
        
    <record id="sale_order_tree_inh" model="ir.ui.view">
            <field name="name">sale.order.tree</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_quotation_tree"/>
            <field name="arch" type="xml">
                <field name="user_id" position="before">
                	<field name="customer_state"/>
                </field>
            </field>
        </record>
        
        
</odoo>
