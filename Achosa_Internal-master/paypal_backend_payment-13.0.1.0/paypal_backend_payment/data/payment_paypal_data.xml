<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="successfull_payment_notification" model="mail.template">
            <field name="name">Successfull Payment</field>
            <field name="model_id" ref="payment.model_payment_transaction"/>
            <field name="subject">Done Payment Successfully</field>
            <field name="partner_to">${object.sale_order_id.partner_id.id},${object.sale_order_id.user_id.partner_id.id}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html"><![CDATA[
                <div style="width: 600px; background-color:#fff">
                  <div style="text-align: left;">
                    <img src="/logo.png" style="width: 80px;" alt="${user.company_id.name}">
                  </div>
                  <div>
                    <h4 style="color: #57697e;">
                      Payment has been done successfully !
                    </h4>
                    <br/>
                    <p>You have done sucessfully payment of <strong>${object.currency_id.symbol} ${object.amount}</strong> for <strong>${object.sale_order_id.name}</strong></p>
                    <p>Your payment transaction number is <strong>${object.acquirer_reference}</strong></p>
                    <br/>
                    <p>Thanks !</p>

                </div>
            ]]></field>
            <field name="user_signature" eval="False"/>
        </record>
    </data>
</odoo>